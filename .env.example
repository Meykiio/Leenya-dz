# Supabase Configuration
# Get these values from: Supabase Dashboard → Settings → API

# Your Supabase project REST API URL
# Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anonymous (public) key for client-side access
# Find this in: Supabase Dashboard → Settings → API → anon public key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# The Supabase project reference ID
# Find this in: Supabase Dashboard → Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=your-project-ref

# WhatsApp support number for the floating help button (without + prefix)
VITE_SUPPORT_PHONE=213XXXXXXXXX
