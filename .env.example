# Supabase Configuration
# Get these values from: Supabase Dashboard → Settings → API

# Your Supabase project REST API URL
# Format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anonymous (public) key for client-side access
# Find this in: Supabase Dashboard → Settings → API → anon public key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# The Supabase project reference ID
# Find this in: Supabase Dashboard → Settings → General → Reference ID
VITE_SUPABASE_PROJECT_ID=your-project-ref

# WhatsApp support number for the floating help button (without + prefix)
VITE_SUPPORT_PHONE=213XXXXXXXXX

# VAPID public key for Web Push notifications
# Must match the VAPID key pair set in the SendGrid Edge Function env vars
VITE_VAPID_PUBLIC_KEY=

# Sentry Error Tracking (optional — leave blank to skip)
# Get DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
VITE_SENTRY_DSN=
# Sentry auth token for source map uploads (build-time only)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=leenya
SENTRY_PROJECT=leenya-web
